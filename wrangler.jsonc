{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "konferenztrinken",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Speicher für Push-Abos. Ohne "id" legt Wrangler den Namespace beim Deploy selbst an.
  "kv_namespaces": [
    { "binding": "PUSH" }
  ],
  // Jede Minute die abonnierten Spiele prüfen und neue Ereignisse pushen.
  "triggers": {
    "crons": ["* * * * *"]
  }
}
