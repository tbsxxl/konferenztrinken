{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "konferenztrinken",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Speicher für Push-Abos. Ohne "id" legt Wrangler den Namespace beim Deploy selbst an.
  "kv_namespaces": [
    { "binding": "PUSH" }
  ],
  // Mehrspieler-Räume für „Der Dümmste fliegt“ (SQLite-Durable-Objects, auch im kostenlosen Tarif).
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],
  // Jede Minute die abonnierten Spiele prüfen und neue Ereignisse pushen.
  "triggers": {
    "crons": ["* * * * *"]
  }
}
